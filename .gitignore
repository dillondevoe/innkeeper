
# Runtime state. ticks.sh and recycle.sh write here; the log is named after the
# HOST, so committing it carries a machine name out of the stack and into the public
# product. The store is created on first use — nothing here is part of the artifact.
state/

# mutation-arm staging: mutants live in bus/ so they can resolve actor.sh; a crashed
# battery must not be able to leave one behind as a committable file.
bus/.mut-*
lifecycle/.mut-*
bus/.plant-probe.sh

# Bytecode. bin/quest_normalize.py is the repo's first importable module, so a python3 that
# writes caches would drop bin/__pycache__/ into a checkout the first time the demo runs. The
# two call sites that import it pass -B so nothing is written at all; this is the belt, for an
# import that arrives by some other route.
__pycache__/
